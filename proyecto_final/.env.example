# Backend (local and Vercel runtime; production values belong in Vercel).
DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:4000/DATABASE?charset=utf8mb4
DATABASE_SSL_VERIFY=true
# Isolated PostgreSQL database used only by app.payments. It does not replace
# the existing MySQL/TiDB DATABASE_URL used by the rest of this application.
PAYMENTS_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/payments
PAYMENT_ENV=sandbox
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_INTEGRITY_SECRET=
WOMPI_API_URL=https://sandbox.wompi.co/v1
APP_URL=http://localhost:5173/payment-return
LOG_LEVEL=INFO
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
ADMIN_REGISTRATION_CODE=FAKE_LOCAL_ONLY_CODE
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
FRONTEND_URL=http://localhost:5173

# Frontend build-time variable. Empty means same-origin /api in production.
VITE_API_URL=http://localhost:8000/api
